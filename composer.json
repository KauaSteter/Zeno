{
    "name": "arielmpires/zeno-erp",
    "type": "project",
    "description": "ZENO ERP - Gestão em Equilíbrio para Pequenas Lojas, Empresas de Serviços e MEI.",
    "keywords": ["framework", "laravel", "erp", "zeno"],
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^11.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump"
        ]
    },
    "config": {
                "optimize-autoloader": true,
                "preferred-install": "dist",
                "sort-packages": true,
                "allow-plugins": {
                    "pestphp/pest-plugin": true,
                    "php-http/discovery": true
                },
                "policy": {
                    "advisories": {
                        "ignore-id": [
                            "PKSA-b41t-wbzk-9q51",
                            "PKSA-d5tc-s1qs-h781",
                            "PKSA-m5cs-t1y6-qpcs",
                            "PKSA-3r5d-mb8f-1qw9",
                            "PKSA-mdq4-51ck-6kdq",
                            "PKSA-8qx3-n5y5-vvnd",
                            "PKSA-q46n-4fdk-zjr4",
                            "PKSA-qzrn-rnz3-85w1",
                            "PKSA-w7xr-vk7n-rstm"
                        ]
                    }
                }
            },
    "minimum-stability": "stable",
    "prefer-stable": true
}
